# Copy this file to .env.local and fill in values from the Supabase project settings.
# The app UI can run without these. Database features require a real project
# after migrations have been applied.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Newer Supabase dashboards label this the publishable key. It is the public
# anon key and is safe to expose in the browser. Never put the service role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional alias used by some Supabase examples. If ANON_KEY is unset, the app
# will fall back to this value.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Server-only. Bypasses Row Level Security. Never expose this to the browser
# or commit a real value. Required to mint short-lived signed download URLs and
# to run the orphan-upload sweep.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Canonical public origin for metadata, sitemap, and robots
# (example: https://example.com). Do not guess a production domain. Local
# development falls back to http://localhost:3000. Vercel previews use
# https://$VERCEL_URL when this is unset.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Optional. Public discussion on resource pages is off for the initial Beta
# unless this is exactly "true". The discussion tables and code stay in the
# repo. This flag is not authorization — RLS still applies.
# NEXT_PUBLIC_DISCUSSION_ENABLED=false

# Server-only. Optional. Lets a scheduler POST /api/maintenance/orphan-uploads
# with an Authorization: Bearer header. Leave unset and only a signed-in Site
# Admin can trigger the sweep; the token path is then disabled, not open.
# Use a long random value. See docs/deployment-hardening.md.
# CRON_SECRET=

# In the Supabase dashboard:
# - Enable Email provider (password). Keep "Confirm email" on.
# - Add Redirect URLs: http://127.0.0.1:3000/callback and your production /callback
# - Do not add OAuth providers in this phase.
# - For Tutorial videos: set the project Global File Size Limit to at least 1 GB,
#   `tutorial-videos` object limit to 1 GB, and keep both resource buckets private.
#   See docs/deployment-hardening.md.
